# ==============================================================================
# NetSentinel Hub — Variáveis de Ambiente (Nobara Linux)
# Copie para .env e proteja com: chmod 0600 .env
# ==============================================================================

# Identificação do Nó Monitorado
NETSENTINEL_NODE_ID=e7plus-jp-ap
NETSENTINEL_LOCATION_LABEL="Apê João Pessoa (Ponta de Campina)"

# Segredo compartilhado HMAC-SHA256 (gere com: openssl rand -hex 32)
# Deve ser IDÊNTICO ao NETSENTINEL_HMAC_SECRET configurado no Moto E7 Plus
NETSENTINEL_HMAC_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# Telegram Bot API (100% gratuito — crie em @BotFather e obtenha chat_id em @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Receptor HTTP do Hub (escuta em LAN / IPv6 / Tailscale)
HUB_BIND_HOST=::
HUB_BIND_PORT=8765

# Limites do Dead Man's Switch e Alertas
HEARTBEAT_TIMEOUT_SEC=180
WATCHDOG_POLL_SEC=10
REPLAY_WINDOW_SEC=300
ALERT_COOLDOWN_SEC=600
FRIDGE_RISK_OUTAGE_SEC=14400

# Armazenamento persistente local
HUB_DATA_DIR=~/.local/share/netsentinel

# Notificações KDE Desktop (notify-send) — 0 desativa popups na tela do PC
ENABLE_DESKTOP_NOTIFY=0
