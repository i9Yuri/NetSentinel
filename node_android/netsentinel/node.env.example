# ==============================================================================
# NetSentinel Node — Configuração do Motorola Moto E7 Plus
# Instalado em: /data/adb/netsentinel/node.env (chmod 0600, root:root)
# ==============================================================================

# Identidade do nó remoto
NETSENTINEL_NODE_ID="e7plus-jp-ap"
NETSENTINEL_LOCATION_LABEL="Apê João Pessoa (Ponta de Campina)"

# Chave compartilhada HMAC-SHA256 (IDÊNTICA ao .env do Hub Nobara Linux)
NETSENTINEL_HMAC_SECRET="CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32"

# Endpoint HTTP/HTTPS do Hub no Nobara Linux (opcional se usar apenas Telegram)
# Exemplos:
#   LAN local:   http://192.168.0.14:8765/api/v1/heartbeat
#   IPv6 global: http://[2804:xxxx:...]:8765/api/v1/heartbeat
#   Tailscale:   http://100.x.y.z:8765/api/v1/heartbeat
HUB_ENDPOINT_URL=""

# Telegram Bot API (redundância 24/7 mesmo com PC desligado — custo R$ 0,00)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Intervalos operacionais (segundos)
HEARTBEAT_INTERVAL_SEC=60
SURVIVAL_POLL_INTERVAL_SEC=120
STATUS_CARD_INTERVAL_SEC=300
SPECTRUM_SCAN_INTERVAL_SEC=60

# Gerenciador de Saúde da Bateria 24/7 (PMI632 bypass)
BATTERY_LIMIT_HIGH=75
BATTERY_LIMIT_LOW=60
BATTERY_FORCE_DISCHARGE_ABOVE=82
BATTERY_TEMP_EMERGENCY_TENTHS=400
BATTERY_TEMP_RESUME_TENTHS=370
BATTERY_LOW_ALERT_PCT=20

# Alerta de risco de geladeira/congelador (segundos sem luz — padrão 4h = 14400s)
FRIDGE_RISK_OUTAGE_SEC=14400

# Radar Passivo de Espectro (Wi-Fi / LAN / BT)
# 0 = Apenas monitora dispositivos conectados na LAN do roteador (recomendado para evitar falsos alarmes de vizinhos/repetidores)
# 1 = Monitora também sinais Wi-Fi de vizinhos no ar
SPECTRUM_SCAN_WIFI_APS=0
LOCAL_TIMEZONE="America/Fortaleza"
SPECTRUM_RSSI_THRESHOLD=-60
SPECTRUM_PERSIST_MIN_SEC=180
SPECTRUM_ALERT_COOLDOWN_SEC=900

# Conectividade / Probe externo
PING_TARGET_PRIMARY="1.1.1.1"
PING_TARGET_SECONDARY="8.8.8.8"
CURL_TIMEOUT_SEC=12
